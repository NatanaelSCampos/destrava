  "writingSystem": { "direction": "ltr", "scripts": ["Latin"], "caseSensitive": false },
  "variants": [
    { "id": "general", "name": "Inglês geral", "default": true },
    { "id": "en-US", "name": "Inglês dos Estados Unidos" },
    { "id": "en-GB", "name": "Inglês do Reino Unido" }
  ],
  "capabilities": {
    "speechRecognition": true,
    "textToSpeech": true,
    "pronunciationAssessment": true,
    "regionalVariants": true,
    "romanization": false,
    "tones": false,
    "grammaticalGender": false
  },
  "speech": {
