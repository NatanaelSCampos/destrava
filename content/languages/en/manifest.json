        "general": { "recognitionLocale": "en-US", "assessmentLocale": "en-US", "ttsLocale": "en-US" },
        "en-US": { "recognitionLocale": "en-US", "assessmentLocale": "en-US", "ttsLocale": "en-US" },
        "en-GB": { "recognitionLocale": "en-GB", "assessmentLocale": "en-GB", "ttsLocale": "en-GB" }
