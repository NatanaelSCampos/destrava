            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16777216
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
