{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "destrava.course-package"
    },
    "envelopeVersion": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "contracts": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "1.1"
          ]
        },
        "course": {
          "type": "string",
          "enum": [
            "1.3",
            "1.4",
            "1.5"
          ]
        }
      },
      "required": [
        "language",
        "course"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "enum": [
            "test",
            "production"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "human",
            "ai_generated",
            "adapted",
            "imported"
          ]
        },
        "sources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "label",
              "reference"
            ],
            "additionalProperties": false
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "review_pending",
                "approved"
              ]
            },
            "reviewedBy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "material",
        "origin",
        "sources",
        "review"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "object",
      "properties": {
        "language": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9._/-]+$"
            },
            "bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 16777216
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "course": {
