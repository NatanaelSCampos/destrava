            "default": true,
            "type": "boolean"
          },
          "resumeAnchorsMs": {
            "default": [
              0
            ],
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "explanation": {
            "type": "string"
