{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capabilityRequirements": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "fallback": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "data": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "isDefault": {
      "default": false,
      "type": "boolean"
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 1
    },
    "targetLanguage": {
      "type": "string",
      "minLength": 1
    },
    "defaultVariant": {
      "type": "string"
    },
    "acceptedVariants": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "framework": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entryLevel": {
          "type": "string"
        },
        "exitLevel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "exitLevel"
      ]
    },
    "track": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "learningGoals": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportedGoals": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "general",
          "travel",
          "work",
          "study",
          "conversation"
        ]
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "enum": [
              "general",
              "travel",
              "work",
              "study",
              "conversation"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "goal"
        ]
      }
    },
    "skillFloors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "speaking",
          "listening",
          "reading",
          "writing"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "assessmentRefs": {
      "default": {},
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "practice": {
      "type": "object",
      "properties": {
        "reviewStructures": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "lessonId": {
                "type": "string",
                "minLength": 1
              },
              "conceptId": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "lessonId",
              "conceptId",
              "title",
              "prompt",
              "answer",
              "explanation"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "human",
            "ai_generated",
            "adapted",
            "imported"
          ]
        },
        "generator": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "reference"
            ]
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "generated",
                "review_pending",
                "approved",
                "published",
                "deprecated"
              ]
            },
            "reviewedBy": {
              "type": "string"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "origin"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "id",
    "slug",
    "sourceLanguage",
    "targetLanguage",
    "framework",
    "track",
    "title",
    "learningGoals"
  ],
  "additionalProperties": false
}
