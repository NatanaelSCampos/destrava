{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capabilityRequirements": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                },
                "fallback": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+\\.\\d+$"
                    },
                    "data": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "enum": [
              "diagnostic",
              "formative",
              "summative"
            ]
          },
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "lessonId": {
            "type": "string",
            "minLength": 1
          },
          "objectiveIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "passingPolicy": {
            "type": "object",
            "properties": {
              "overall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minimumBySkill": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "reading",
                    "writing",
                    "listening",
                    "speaking",
                    "vocabulary",
                    "grammar",
                    "pronunciation",
                    "fluency",
                    "comprehension"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "required": [
              "overall"
            ]
          },
          "method": {
            "type": "string",
            "const": "adaptive"
          },
          "skillWeights": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "reading",
                "writing",
                "listening",
                "speaking",
                "vocabulary",
                "grammar",
                "pronunciation",
                "fluency",
                "comprehension"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "skillPlan": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reading",
                "writing",
                "listening",
                "speaking",
                "vocabulary",
                "grammar",
                "pronunciation",
                "fluency",
                "comprehension"
              ]
            }
          },
          "bank": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "activityId": {
                  "type": "string",
                  "minLength": 1
                },
                "skill": {
                  "type": "string",
                  "enum": [
                    "reading",
                    "writing",
                    "listening",
                    "speaking",
                    "vocabulary",
                    "grammar",
                    "pronunciation",
                    "fluency",
                    "comprehension"
                  ]
                },
                "difficulty": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    },
                    {
                      "type": "number",
                      "const": 3
                    }
                  ]
                },
                "ceiling": {
                  "type": "boolean"
                }
              },
              "required": [
                "activityId",
                "skill",
                "difficulty"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "purpose",
          "passingPolicy",
          "method",
          "skillWeights",
          "skillPlan",
          "bank"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capabilityRequirements": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                },
                "fallback": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^\\d+\\.\\d+\\.\\d+$"
                    },
                    "data": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "enum": [
              "diagnostic",
              "formative",
              "summative"
            ]
          },
          "unitId": {
            "type": "string",
            "minLength": 1
          },
          "lessonId": {
            "type": "string",
            "minLength": 1
          },
          "objectiveIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "passingPolicy": {
            "type": "object",
            "properties": {
              "overall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minimumBySkill": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    "reading",
                    "writing",
                    "listening",
                    "speaking",
                    "vocabulary",
                    "grammar",
                    "pronunciation",
                    "fluency",
                    "comprehension"
                  ]
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "required": [
              "overall"
            ]
          },
          "method": {
            "type": "string",
            "const": "fixed"
          },
          "gradingStrategy": {
            "type": "string",
            "const": "objective_mean"
          },
          "activityIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "purpose",
          "passingPolicy",
          "method",
          "gradingStrategy",
          "activityIds"
        ],
        "additionalProperties": false
      }
