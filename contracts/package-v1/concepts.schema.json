{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "language": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 2
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "prerequisites": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1
            },
            "translations": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 2
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "target",
            "translations"
          ]
        }
      }
    },
    "required": [
      "id",
      "language",
      "type",
      "name"
    ]
  }
}
