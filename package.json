{
  "name": "destrava",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run content:compile",
    "dev": "next dev",
    "prebuild": "npm run content:compile",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "content:pedagogy": "node --import tsx scripts/content-pedagogy.ts",
    "content:compile": "node --import tsx scripts/compile-content.ts",
    "content:preview": "node --import tsx scripts/content-preview.ts",
    "learning:verify": "node --import tsx scripts/verify-learning-engine.ts",
    "policies:verify": "node --import tsx scripts/verify-learning-policies.tsx",
    "assessment:verify": "node --import tsx scripts/verify-adaptive-assessments.ts",
    "assessment:semantics:verify": "node --import tsx scripts/verify-assessment-semantics.tsx",
    "multilingual:verify": "node --import tsx scripts/verify-multilingual.ts",
    "onboarding:verify": "node --import tsx scripts/verify-onboarding.ts",
    "interactive:verify": "node --import tsx scripts/verify-interactive-lessons.ts",
    "interactive:verify:remote": "node --env-file=.env.local --import tsx scripts/verify-interactive-session-remote.ts",
    "architecture:check": "node --import tsx scripts/check-architecture.ts",
    "contracts:verify": "node --import tsx scripts/verify-contract-vocabulary.ts",
    "capabilities:verify": "node --import tsx scripts/verify-capabilities.tsx",
    "text:verify": "node --import tsx scripts/verify-text-representation.tsx",
    "text:verify:ui": "node --import tsx scripts/verify-text-ui.tsx",
    "capabilities:catalog": "node --import tsx scripts/export-capability-catalog.ts",
    "session:verify": "node --import tsx scripts/verify-session-time.ts",
    "sync:verify": "node --import tsx scripts/verify-study-sync.ts",
    "checkpoint:prepare": "node scripts/prepare-local-checkpoint.mjs",
    "checkpoint:restart": "node scripts/run-local-checkpoint.mjs restart",
    "checkpoint:migrate": "node scripts/run-local-checkpoint.mjs migrate",
    "checkpoint:seed": "node scripts/run-local-checkpoint.mjs seed",
    "checkpoint:verify": "node scripts/run-local-checkpoint.mjs verify",
    "dev:local": "node scripts/run-local-checkpoint.mjs dev",
    "build:local": "node scripts/run-local-checkpoint.mjs build",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-supabase.ts",
    "db:verify:remote": "node --env-file=.env.local --import tsx scripts/verify-content-remote.ts",
    "db:verify:local": "node scripts/run-local-checkpoint.mjs verify",
    "format": "prettier --write src scripts package.json next.config.ts tsconfig.json postcss.config.mjs eslint.config.mjs",
    "variants:verify": "node --import tsx scripts/verify-variants.tsx",
    "variants:verify:ui": "node --import tsx scripts/verify-variants-ui.tsx",
    "presentation:verify": "node --import tsx scripts/verify-text-presentation.tsx",
    "presentation:verify:ui": "node --import tsx scripts/verify-text-presentation-ui.tsx",
    "package:contracts": "node --import tsx scripts/export-package-contracts.ts",
    "package:validate": "node --import tsx scripts/validate-external-package.ts",
    "package:verify": "node --import tsx scripts/verify-external-packages.tsx",
    "package:example": "node scripts/produce-external-course.mjs",
    "installations:verify": "node --import tsx scripts/verify-course-installations.tsx",
    "installations:verify:local": "node scripts/run-course-installations-local.mjs verify",
    "installations:local": "node scripts/run-course-installations-local.mjs manage"
